<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description>Write a script to show incident count for each state which are updated today?</description>
        <name>Incident State updated today</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[var ga = new GlideAggregate('incident');
ga.addAggregate('COUNT','priority');
ga.addEncodedQuery('sys_updated_onONToday@javascript:gs.beginningOfToday()@javascript:gs.endOfToday()');
ga.query();
while (ga.next()) {
  gs.print(ga.getDisplayValue('priority')+' : '+ga.getAggregate('COUNT', 'priority'));
}]]></script>
