<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description/>
        <name>Print Incident Number based on Priority</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[ 

var obj = {};
var gr = new GlideRecord("incident");
// gr.addQuery("active",true);a 
gr.query();
while(gr.next()){
   var priority = "priority - " + gr.getValue("priority");
   if(obj.hasOwnProperty(priority)){
      obj[priority] = obj[priority] + "," + gr.getValue("number");
   }
   else{
      obj[priority] = gr.getValue("number");
   }
}

gs.info(JSON.stringify(obj))

 

]]></script>
